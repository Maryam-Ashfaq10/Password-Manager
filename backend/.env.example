# Copy this file to .env and fill in real values.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# SQLite database location (relative to backend/prisma/)
DATABASE_URL="file:./dev.db"

# 32-byte hex key used to AES-256-GCM encrypt passwords/notes at rest.
# Keep this OUT of the database and out of git. Losing it means losing your vault.
ENCRYPTION_KEY=""

# Secret used to sign login session tokens (JWT). Added in Phase 3.
JWT_SECRET=""

# Port the API listens on.
PORT=3001
